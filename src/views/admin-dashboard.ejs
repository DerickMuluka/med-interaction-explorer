<h2 style="margin-bottom: 1.5rem;">🛡 Admin Dashboard</h2>

<div class="grid">
    <!-- Pending verification -->
    <div class="card">
        <h3>Pending Verifications</h3>
        <% if (pending.length === 0) { %>
            <p style="color: var(--text-muted);">No users awaiting verification.</p>
        <% } else { %>
            <table>
                <thead><tr><th>Username</th><th>Registered</th><th></th></tr></thead>
                <tbody>
                <% pending.forEach(u => { %>
                    <tr>
                        <td><%= u.username %></td>
                        <td><%= new Date(u.created_at).toLocaleString() %></td>
                        <td>
                            <form action="/admin/verify/<%= u.id %>" method="POST" style="margin:0;">
                                <button type="submit" style="width:auto; padding:0.35rem 0.75rem;">Verify</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        <% } %>
    </div>

    <!-- Create user -->
    <div class="card">
        <h3>Create User Account</h3>
        <form action="/admin/create-user" method="POST">
            <input type="text" name="username" placeholder="Username" required>
            <input type="password" name="password" placeholder="Temporary password" required>
            <select name="role">
                <option value="user">User</option>
                <option value="admin">Admin</option>
            </select>
            <button type="submit">Create Account</button>
        </form>
    </div>
</div>

<!-- All users -->
<div class="card" style="margin-top: 2rem;">
    <h3>All Users</h3>
    <table>
        <thead>
            <tr><th>ID</th><th>Username</th><th>Role</th><th>Verified</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
        <% users.forEach(u => { %>
            <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><span class="badge badge-minor"><%= u.role %></span></td>
                <td><%= u.is_verified ? '✅' : '❌' %></td>
                <td><%= new Date(u.created_at).toLocaleString() %></td>
                <td style="display:flex; gap:0.5rem;">
                    <form action="/admin/reset-password/<%= u.id %>" method="POST" style="margin:0; display:flex; gap:0.3rem;">
                        <input type="password" name="newPassword" placeholder="New password"
                               style="margin:0; padding:0.35rem; width:140px;">
                        <button type="submit" style="width:auto; padding:0.35rem 0.75rem;">Reset</button>
                    </form>
                    <% if (u.role !== 'admin') { %>
                        <form action="/admin/delete/<%= u.id %>" method="POST" style="margin:0;"
                              onsubmit="return confirm('Delete user <%= u.username %>?')">
                            <button type="submit"
                                style="width:auto; padding:0.35rem 0.75rem; background: var(--danger); color:#fff;">
                                Delete
                            </button>
                        </form>
                    <% } %>
                </td>
            </tr>
        <% }); %>
        </tbody>
    </table>
</div>